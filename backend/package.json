{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/index.js",
  "type": "module",
  "imports": {
    "#@/*": {
      "production": "./dist/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "test": "vitest",
    "dev": "concurrently -n \"SERVER,WORKER\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:server": "nodemon --ext ts,js,json --watch src --ignore src/worker.ts --exec tsx src/index.ts",
    "dev:worker": "nodemon --ext ts,js,json --watch src/worker.ts --watch src/background --exec tsx src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "pm2:logs": "pm2 logs",
    "pm2:clean": "pm2 delete all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/multer": "^2.2.0",
    "bullmq": "^5.81.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "http-errors": "^2.0.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
