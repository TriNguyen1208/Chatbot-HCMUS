# University RAG Backend - Environment Configuration
# Copy this file to .env and fill in the values

# ============= Qdrant Vector Store =============
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=university_documents

# ============= Embedding Configuration =============
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=384

# ============= Chunking Configuration =============
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=40

# ============= Parser Configuration =============
COMPLEXITY_CHAR_DENSITY_LOW=300.0
COMPLEXITY_CHAR_DENSITY_HIGH=600.0
COMPLEXITY_TABLE_COUNT_THRESHOLD=5
COMPLEXITY_VECTOR_PATH_THRESHOLD=0.30

# ============= LlamaCloud Parser (for complex PDFs) =============
# Get API key from https://cloud.llamaindex.ai
LLAMACLOUD_API_KEY=
LLAMACLOUD_REQUEST_TIMEOUT=300

# ============= OpenAI LLM =============
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1024

# ============= Ollama (Local LLM) =============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.3

# ============= Inference Configuration =============
# Which LLM provider to use: "openai" or "ollama"
INFERENCE_LLM_PROVIDER=openai
RETRIEVAL_TOP_K=20
RERANKING_TOP_N=5

# ============= Data Paths =============
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ============= Logging =============
LOG_LEVEL=INFO
